# ==============================================================================
# ShoeStop Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment (Local / Cloud).
# NEVER commit your actual .env file with secrets to public version control.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Configuration
# For local Docker Compose deployment:
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=shoestop_secure_pass
MONGO_DB_NAME=shoestop
# Local Docker MongoDB URI:
# mongoURI=mongodb://admin:shoestop_secure_pass@shoestop-db:27017/shoestop?authSource=admin

# For Cloud MongoDB Atlas deployment:
mongoURI=mongodb+srv://<username>:<password>@<cluster-domain>/shoestop?retryWrites=true&w=majority

# Authentication / Security
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
expiry=30d

# Frontend API URL Configuration
# For local development/testing: http://localhost:5000
# For cloud deployment: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:5000
